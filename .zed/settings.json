{
  "prettier": {
    "allowed": false
  },
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "oxlint", "oxfmt"],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JavaScript": {
      "language_servers": ["vtsls", "oxlint", "oxfmt"],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSON": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "Markdown": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  }
}
