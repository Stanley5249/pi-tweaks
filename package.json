    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003"
  },
  "dependencies": {
    "@catppuccin/palette": "1.8.0"
  }
}
