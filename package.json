{
  "name": "pi-tweaks",
  "version": "0.0.0",
  "private": true,
  "description": "Personal Pi extensions for context inspection and status display.",
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/catppuccin/index.ts",
      "./src/context/index.ts",
      "./src/fast/index.ts",
      "./src/statusline/index.ts"
    ],
    "themes": [
      "./src/catppuccin/themes/*.json"
    ]
  }
}
