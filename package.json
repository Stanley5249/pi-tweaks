{
  "name": "pi-tweaks",
  "version": "0.0.0",
  "private": true,
  "description": "Personal Pi extensions for context inspection and status display.",
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "@earendil-works/pi-tui": "^1.5.1",
    "@types/bun": "1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typebox": "1.4.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/catppuccin/index.ts",
      "./src/context/index.ts",
      "./src/fast/index.ts",
      "./src/bell/index.ts",
      "./src/guard/index.ts",
      "./src/statusline/index.ts"
    ],
    "themes": [
      "./src/catppuccin/themes/*.json"
    ]
  }
}
